{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josh-room.invalid/schemas/session-evidence-session-final.schema.json",
  "title": "Session Evidence Envelope v1 session final",
  "type": "object",
  "additionalProperties": true,
  "patternProperties": {"(^|_)path$": false},
  "required": ["schema_name", "schema_version", "kind", "event_id", "source", "profile_id", "workspace_id", "device_id", "checkpoint", "record_count", "content_sha256", "content_size", "capture"],
  "properties": {"schema_name": {"const": "codex-session-evidence"}, "schema_version": {"$ref": "#/$defs/version"}, "kind": {"const": "session-final"}, "event_id": {"$ref": "#/$defs/identifier"}, "session_id": {"$ref": "#/$defs/identifier"}, "thread_id": {"$ref": "#/$defs/identifier"}, "turn_id": {"$ref": "#/$defs/identifier"}, "subagent": {"$ref": "#/$defs/subagent"}, "source": {"$ref": "#/$defs/source"}, "profile_id": {"$ref": "#/$defs/identifier"}, "workspace_id": {"$ref": "#/$defs/identifier"}, "device_id": {"$ref": "#/$defs/identifier"}, "repository": {"$ref": "#/$defs/repository"}, "checkpoint": {"$ref": "#/$defs/checkpoint"}, "last_segment_sha256": {"$ref": "#/$defs/digest"}, "record_count": {"type": "integer", "minimum": 0}, "content_sha256": {"$ref": "#/$defs/digest"}, "content_size": {"type": "integer", "minimum": 0}, "capture": {"$ref": "#/$defs/capture"}, "observed_at": {"$ref": "#/$defs/timestamp"}}
  ,"$defs": {"version": {"type": "object", "additionalProperties": false, "required": ["major", "minor"], "properties": {"major": {"const": 1}, "minor": {"type": "integer", "minimum": 0}}}, "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"}, "version-identifier": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._~-]*$"}, "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source": {"type": "object", "additionalProperties": false, "required": ["surface", "adapter", "adapter_version"], "properties": {"surface": {"enum": ["cli", "desktop", "vscode", "app-server", "import", "unknown"]}, "adapter": {"$ref": "#/$defs/identifier"}, "adapter_version": {"$ref": "#/$defs/version-identifier"}, "codex_version": {"$ref": "#/$defs/version-identifier"}}}, "subagent": {"type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": {"id": {"$ref": "#/$defs/identifier"}, "type": {"$ref": "#/$defs/identifier"}}}, "repository": {"type": "object", "additionalProperties": false, "required": ["remote", "commit", "branch", "dirty"], "properties": {"remote": {"type": "string", "maxLength": 128, "pattern": "^(unknown|[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)+)$"}, "commit": {"type": "string", "pattern": "^(unknown|[0-9a-f]{7,64})$"}, "branch": {"type": "string", "maxLength": 128, "pattern": "^(unknown|[A-Za-z0-9][A-Za-z0-9._/-]*[A-Za-z0-9])$"}, "dirty": {"enum": [true, false, "unknown"]}}}, "checkpoint": {"type": "object", "additionalProperties": false, "required": ["source", "representation", "start", "end", "prefix_sha256"], "properties": {"source": {"$ref": "#/$defs/identifier"}, "representation": {"enum": ["active-jsonl", "archived-jsonl", "compressed-jsonl-zst", "unknown"]}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}, "prefix_sha256": {"$ref": "#/$defs/digest"}}}, "capture": {"type": "object", "additionalProperties": false, "required": ["status", "policy_decision", "sensitivity", "counters"], "properties": {"status": {"enum": ["partial", "complete", "recovered", "quarantined"]}, "policy_decision": {"enum": ["allow", "deny", "local-only", "quarantine"]}, "sensitivity": {"enum": ["normal", "sensitive", "unknown"]}, "counters": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}}
}
