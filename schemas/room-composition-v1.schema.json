{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://josh-room.dev/schemas/room-composition-v1.schema.json",
  "title": "Room composition v1 (preview contract; not storage authority)",
  "$comment": "Use composition.parse_manifest as well: portable paths, aliased ancestors, overlapping paths and repeated Room identities require semantic validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "children"
  ],
  "properties": {
    "format": {
      "const": "room-composition-v1"
    },
    "children": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connection_id",
          "dimension_id",
          "room_id",
          "snapshot_id",
          "path",
          "provider",
          "hydration"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "dimension_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "room_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "snapshot_id": {
            "allOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              {
                "not": {
                  "pattern": "^[Ll][Aa][Tt][Ee][Ss][Tt]$"
                }
              }
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "provider": {
            "enum": [
              "r2",
              "minio",
              "s3"
            ]
          },
          "hydration": {
            "const": "explicit"
          }
        }
      }
    }
  }
}
