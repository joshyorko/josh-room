{
  "name": "josh-room",
  "displayName": "Josh Room",
  "description": "Native Save, Enter, Serve, and Remove controls for Josh's disposable Rooms.",
  "version": "0.1.0",
  "publisher": "joshyorko",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:joshRoom.save",
    "onCommand:joshRoom.new",
    "onCommand:joshRoom.enter",
    "onCommand:joshRoom.remove",
    "onCommand:joshRoom.serve",
    "onCommand:joshRoom.refresh",
    "onView:joshRoom.rooms"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "joshRoom.new",
        "title": "Josh: New Room",
        "icon": "$(add)"
      },
      {
        "command": "joshRoom.save",
        "title": "Josh: Save Room",
        "icon": "$(save-as)"
      },
      {
        "command": "joshRoom.enter",
        "title": "Josh: Enter Room",
        "icon": "$(folder-opened)"
      },
      {
        "command": "joshRoom.remove",
        "title": "Josh: Remove Room",
        "icon": "$(trash)"
      },
      {
        "command": "joshRoom.serve",
        "title": "Josh: Serve Room Images",
        "icon": "$(server-process)"
      },
      {
        "command": "joshRoom.refresh",
        "title": "Josh: Refresh Rooms",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "josh-room",
          "title": "Josh Room",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "josh-room": [
        {
          "id": "joshRoom.rooms",
          "name": "Rooms",
          "contextualTitle": "Josh Room"
        }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "joshRoom.new", "when": "view == joshRoom.rooms", "group": "navigation@1" },
        { "command": "joshRoom.save", "when": "view == joshRoom.rooms", "group": "navigation@2" },
        { "command": "joshRoom.refresh", "when": "view == joshRoom.rooms", "group": "navigation@3" }
      ],
      "view/item/context": [
        { "command": "joshRoom.enter", "when": "view == joshRoom.rooms && viewItem == room", "group": "inline@1" },
        { "command": "joshRoom.serve", "when": "view == joshRoom.rooms && viewItem == room", "group": "inline@2" },
        { "command": "joshRoom.remove", "when": "view == joshRoom.rooms && viewItem == room", "group": "inline@3" }
      ]
    }
  }
}
