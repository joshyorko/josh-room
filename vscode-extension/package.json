      "view/item/context": [
        {
          "command": "joshRoom.refreshCatalogPins",
          "when": "view == joshRoom.rooms && viewItem == open-catalog-workspace",
          "group": "catalog@1"
        },
        {
          "command": "joshRoom.manageCatalogDeletion",
          "when": "view == joshRoom.rooms && viewItem == catalog-parent-deletable",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.deleteCatalogItem",
          "when": "view == joshRoom.rooms && (viewItem == catalog-point-deletable || viewItem == catalog-child-room || viewItem == catalog-child-point)",
          "group": "catalog@2"
        },
        {
          "command": "joshRoom.restoreCatalogChildren",
          "when": "view == joshRoom.rooms && (viewItem == catalog-parent || viewItem == catalog-point || viewItem == catalog-parent-deletable || viewItem == catalog-point-deletable)",
          "group": "catalog@1"
        },
        {
          "command": "joshRoom.agentSessionsStatus",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "room@4"
        },
        {
          "command": "joshRoom.connectStorage",
          "when": "view == joshRoom.rooms && viewItem == provider-connection",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.reconnectStorage",
          "when": "view == joshRoom.rooms && viewItem == provider-connection-expired",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.editConnection",
          "when": "view == joshRoom.rooms && (viewItem == provider-connection || viewItem == provider-connection-connected || viewItem == provider-connection-expired)",
          "group": "inline@2"
        },
        {
          "command": "joshRoom.disconnectStorage",
          "when": "view == joshRoom.rooms && (viewItem == provider-connection || viewItem == provider-connection-connected || viewItem == provider-connection-expired)",
          "group": "inline@3"
        },
        {
          "command": "joshRoom.editStorageSettings",
          "when": "view == joshRoom.rooms && viewItem =~ /^dimension(-ready|-minio-ready|-s3-ready|-uninitialized|-insecure|-legacy|-resumable|-failed)?$/",
          "group": "settings@2"
        },
        {
          "command": "joshRoom.initializeEncryption",
          "when": "view == joshRoom.rooms && viewItem == dimension-uninitialized",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.initializeEncryption",
          "when": "view == joshRoom.rooms && viewItem == dimension-insecure",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.migrateEncryption",
          "when": "view == joshRoom.rooms && viewItem == dimension-legacy",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.resumeEncryption",
          "when": "view == joshRoom.rooms && viewItem == dimension-resumable",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.importRecovery",
          "when": "view == joshRoom.rooms && (viewItem == dimension-uninitialized || viewItem == dimension-insecure)",
          "group": "recovery@2"
        },
        {
          "command": "joshRoom.exportRecovery",
          "when": "view == joshRoom.rooms && (viewItem == dimension-minio-ready || viewItem == dimension-s3-ready)",
          "group": "recovery@3"
        },
        {
          "command": "joshRoom.enter",
          "when": "view == joshRoom.rooms && viewItem == room",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.save",
          "when": "view == joshRoom.rooms && viewItem == current-room",
          "group": "inline@1"
        },
        {
          "command": "joshRoom.link",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "room@2"
        },
        {
          "command": "joshRoom.repair",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "room@3"
        },
        {
          "command": "joshRoom.serve",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "room@2"
        },
        {
          "command": "joshRoom.serve",
          "when": "view == joshRoom.rooms && viewItem == jat",
          "group": "inline@2"
        },
        {
          "command": "joshRoom.inspectLogicalSnapshot",
          "when": "view == joshRoom.rooms && (viewItem == logical-jat || viewItem == catalog-point || viewItem == catalog-point-deletable || viewItem == catalog-child-point)",
          "group": "logical@1"
        },
        {
          "command": "joshRoom.agentRecoveryStatus",
          "when": "view == joshRoom.rooms && viewItem == logical-jat",
          "group": "agent-history@1"
        },
        {
          "command": "joshRoom.captureAgentRecovery",
          "when": "view == joshRoom.rooms && viewItem == logical-jat",
          "group": "agent-history@2"
        },
        {
          "command": "joshRoom.restoreAgentRecovery",
          "when": "view == joshRoom.rooms && viewItem == logical-jat",
          "group": "agent-history@3"
        },
        {
          "command": "joshRoom.exportPortableJat",
          "when": "view == joshRoom.rooms && (viewItem == logical-jat || viewItem == catalog-point || viewItem == catalog-point-deletable || viewItem == catalog-child-point)",
          "group": "logical@2"
        },
        {
          "command": "joshRoom.extractLogicalSnapshot",
          "when": "view == joshRoom.rooms && (viewItem == logical-jat || viewItem == catalog-point || viewItem == catalog-point-deletable || viewItem == catalog-child-point)",
          "group": "logical@3"
        },
        {
          "command": "joshRoom.serveLogicalSnapshot",
          "when": "view == joshRoom.rooms && (viewItem == logical-jat || viewItem == catalog-point || viewItem == catalog-point-deletable || viewItem == catalog-child-point)",
          "group": "logical@4"
        },
        {
          "command": "joshRoom.verifyRoomStore",
          "when": "view == joshRoom.rooms && viewItem =~ /^dimension(-ready|-minio-ready)?$/",
          "group": "room-store@1"
        },
        {
          "command": "joshRoom.optimizeRoomStore",
          "when": "view == joshRoom.rooms && viewItem =~ /^dimension(-ready|-minio-ready)?$/",
          "group": "room-store@2"
        },
        {
          "command": "joshRoom.reconcileRoomStore",
          "when": "view == joshRoom.rooms && viewItem =~ /^dimension(-ready|-minio-ready)?$/",
          "group": "room-store@3"
        },
        {
          "command": "joshRoom.remove",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "inline@3"
        },
        {
          "command": "joshRoom.deleteRoom",
          "when": "view == joshRoom.rooms && (viewItem == room || viewItem == current-room)",
          "group": "room@4"
        },
        {
          "command": "joshRoom.deleteRecoveryPoint",
          "when": "view == joshRoom.rooms && (viewItem == jat || viewItem == logical-jat)",
          "group": "recovery@9"
        },
        {
          "command": "joshRoom.browseRecoveryPoint",
          "when": "view == joshRoom.rooms && viewItem == logical-jat",
          "group": "recovery@1"
        },
        {
          "command": "joshRoom.explore3D",
          "when": "view == joshRoom.rooms && (viewItem == current-room || viewItem == open-catalog-workspace || viewItem == open-room-workspace)",
          "group": "room@1"
        }
      ]
    }
  }
}
