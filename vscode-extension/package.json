    "onCommand:joshRoom.inspectLogicalSnapshot",
    "onCommand:joshRoom.agentSessionsStatus",
    "onCommand:joshRoom.agentRecoveryStatus",
    "onCommand:joshRoom.captureAgentRecovery",
    "onCommand:joshRoom.restoreAgentRecovery",
    "onCommand:joshRoom.exportPortableJat",
    "onCommand:joshRoom.extractLogicalSnapshot",
    "onCommand:joshRoom.verifyRoomStore",
    "onCommand:joshRoom.optimizeRoomStore",
    "onCommand:joshRoom.reconcileRoomStore",
    "onCommand:joshRoom.refresh",
    "onCommand:joshRoom.prepare",
    "onCommand:joshRoom.showLogs",
    "onCommand:joshRoom.clearLocalFallback",
    "onCommand:joshRoom.jatBuild",
    "onCommand:joshRoom.jatInspect",
    "onCommand:joshRoom.jatExtract",
    "onCommand:joshRoom.jatRestore",
    "onCommand:joshRoom.jatServe",
    "onCommand:joshRoom.jatExport",
    "onCommand:joshRoom.jatCopy",
    "onView:joshRoom.rooms",
    "onCommand:joshRoom.splitWorkspace",
    "onCommand:joshRoom.saveCatalog",
    "onCommand:joshRoom.restoreCatalog",
    "onCommand:joshRoom.deleteCatalogItem",
    "onCommand:joshRoom.manageCatalogDeletion",
    "onCommand:joshRoom.restoreCatalogChildren",
    "onCommand:joshRoom.enterChild",
    "onCommand:joshRoom.saveChild",
    "onCommand:joshRoom.refreshCatalogPins",
    "onCommand:joshRoom.browseRecoveryPoint",
    "onCommand:joshRoom.explore3D",
    "onCommand:joshRoom.stopRoomView"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Josh Room requires a trusted workspace before reading or changing Room data."
    }
  },
  "contributes": {
    "commands": [
