    "viewsContainers": {
      "activitybar": [
        {
          "id": "josh-room",
          "title": "Josh Room",
          "icon": "media/room.svg"
        }
      ]
    },
    "views": {
      "josh-room": [
        {
          "id": "joshRoom.rooms",
          "name": "Rooms",
          "contextualTitle": "Josh Room"
        },
        {
          "id": "joshRoom.jatTools",
          "name": "JAT Tools",
          "contextualTitle": "JAT Tools",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "joshRoom.rooms",
        "contents": "Connect storage to begin.\n[Connect Storage](command:joshRoom.addStorage)\n[Load Existing Storage](command:joshRoom.prepare)",
        "when": "joshRoom.roomsEmpty"
      }
    ],
    "configuration": {
      "title": "Josh Room",
      "properties": {
        "joshRoom.onboarding.editor": {
          "type": "string",
          "enum": [
            "vscode",
            "none"
          ],
          "default": "vscode",
          "description": "Editor configuration mode used when creating a New Room. A missing AGENTS.md is generated in either mode."
        },
        "joshRoom.onboarding.files": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tasks.json",
              "launch.json",
              "extensions.json",
              "settings.json"
            ]
          },
          "default": [
            "tasks.json",
            "launch.json",
            "extensions.json",
            "settings.json"
          ],
          "uniqueItems": true,
          "description": "VS Code files New Room may create when editor mode is vscode. Existing files are preserved. Use an empty array to disable editor files."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "joshRoom.new",
          "when": "view == joshRoom.rooms && joshRoom.workspaceKind == folder",
          "group": "navigation@1"
        },
        {
          "command": "joshRoom.new",
          "when": "view == joshRoom.rooms && joshRoom.workspaceKind =~ /^(room|catalog|child)$/",
          "group": "workspace@1"
        },
        {
          "command": "joshRoom.addStorage",
          "when": "view == joshRoom.rooms",
          "group": "storage@1"
        },
        {
          "command": "joshRoom.refresh",
          "when": "view == joshRoom.rooms",
          "group": "navigation@3"
        },
        {
          "command": "joshRoom.prepare",
          "when": "view == joshRoom.rooms",
          "group": "4_load"
        }
      ],
      "commandPalette": [
        {
          "command": "joshRoom.new",
          "when": "true"
        },
        {
          "command": "joshRoom.addStorage",
          "when": "true"
