{
  "name": "josh-room",
  "displayName": "Josh Room",
  "description": "Native Save, Enter, Serve, and snapshot controls for Josh's disposable Rooms.",
  "version": "1.0.2",
  "publisher": "joshyorko",
  "repository": {
    "type": "git",
    "url": "https://github.com/joshyorko/josh-room.git"
  },
  "scripts": {
    "test": "node --test *.test.js",
    "package": "npx --yes @vscode/vsce@4.0.0 package --no-dependencies"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:joshRoom.save",
    "onCommand:joshRoom.showOperation",
    "onCommand:joshRoom.saveFolderAs",
    "onCommand:joshRoom.checkWorkspace",
    "onCommand:joshRoom.new",
