+#[cfg(test)]
+mod scoped_ca_tests {
+    use super::parse_scoped_ca;
+
+    #[test]
+    fn scoped_ca_rejects_empty_malformed_and_oversized_bundles() {
+        for input in [b"".as_slice(), b"   ", b"not a certificate", b"-----BEGIN CERTIFICATE-----bad-----END CERTIFICATE-----",
+                      b"-----BEGIN CERTIFICATE-----\n-----BEGIN PRIVATE KEY-----\nYWJj\n-----END PRIVATE KEY-----\n-----END CERTIFICATE-----"] {
+            assert!(parse_scoped_ca(input).is_err());
+        }
+        assert!(parse_scoped_ca(&vec![b'x'; 1024 * 1024 + 1]).is_err());
+    }
+
+    #[test]
+    #[ignore = "requires the owned TLS/S3 fixture"]
+    fn operators_do_not_share_scoped_trust() {
+        use super::{BTreeMap, OpenDALBackend};
+        let endpoint = std::env::var("JOSH_ROOM_CANDIDATE_TLS_ENDPOINT").unwrap();
+        let trusted_ca = std::env::var("JOSH_ROOM_CANDIDATE_TLS_CA").unwrap();
+        let wrong_ca = std::env::var("JOSH_ROOM_CANDIDATE_TLS_OTHER_CA").unwrap();
+        let base = BTreeMap::from([
+            ("endpoint".to_string(), endpoint),
+            ("bucket".to_string(), "synthetic-candidate".to_string()),
+            ("root".to_string(), "repository".to_string()),
+            ("region".to_string(), "us-east-1".to_string()),
+            ("access_key_id".to_string(), "synthetic-key".to_string()),
+            ("secret_access_key".to_string(), "synthetic-secret".to_string()),
+            ("retry".to_string(), "off".to_string()),
+        ]);
+        let mut trusted_options = base.clone();
+        trusted_options.insert("cacert".to_string(), trusted_ca);
+        let trusted = OpenDALBackend::new("s3", trusted_options).unwrap();
+        assert!(trusted.operator.read("config").is_ok());
+        let ordinary = OpenDALBackend::new("s3", base.clone()).unwrap();
+        assert!(ordinary.operator.read("config").is_err());
+        let mut wrong_options = base;
+        wrong_options.insert("cacert".to_string(), wrong_ca);
+        let wrong = OpenDALBackend::new("s3", wrong_options).unwrap();
+        assert!(wrong.operator.read("config").is_err());
+        assert!(trusted.operator.read("config").is_ok());
+        println!("SCOPED_OPERATOR_ISOLATION_PASS");
+    }
+}
