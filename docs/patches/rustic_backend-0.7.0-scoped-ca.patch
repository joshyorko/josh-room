+// Scoped roots augment normal platform trust on this operator only. Never
+// replace the process-global transport or bypass chain/hostname verification.
+fn parse_scoped_ca(pem: &[u8]) -> RusticResult<Vec<reqwest::Certificate>> {
+    const BEGIN: &str = "-----BEGIN CERTIFICATE-----";
+    const END: &str = "-----END CERTIFICATE-----";
+    let invalid = || RusticError::new(ErrorKind::InvalidInput, "Invalid scoped CA bundle");
+    if pem.len() > 1024 * 1024 {
+        return Err(invalid());
+    }
+    let mut remaining = std::str::from_utf8(pem).map_err(|_| invalid())?.trim();
+    let mut certificates = Vec::new();
+    while !remaining.is_empty() {
+        if !remaining.starts_with(BEGIN) || certificates.len() >= 64 {
+            return Err(invalid());
+        }
+        let end = remaining.find(END).ok_or_else(invalid)? + END.len();
+        let block = &remaining[..end];
+        let body = &block[BEGIN.len()..block.len() - END.len()];
+        if body.contains("-----") {
+            return Err(invalid());
+        }
+        use rustls_pki_types::{CertificateDer, pem::PemObject};
+        let mut decoded = CertificateDer::pem_slice_iter(block.as_bytes());
+        let certificate = decoded.next().ok_or_else(invalid)?.map_err(|_| invalid())?;
+        if decoded.next().is_some() {
+            return Err(invalid());
+        }
+        let _ = webpki::anchor_from_trusted_cert(&certificate).map_err(|_| invalid())?;
+        certificates.push(reqwest::Certificate::from_der(certificate.as_ref()).map_err(|_| invalid())?);
+        remaining = remaining[end..].trim();
+    }
+    if certificates.is_empty() {
+        return Err(invalid());
+    }
+    Ok(certificates)
+}
+
+fn scoped_tls_client(path: &str) -> RusticResult<reqwest::Client> {
+    let invalid = || RusticError::new(ErrorKind::InvalidInput, "Invalid scoped CA bundle");
+    let mut pem = Vec::new();
+    let _ = std::fs::File::open(path).map_err(|_| invalid())?
+        .take(1024 * 1024 + 1).read_to_end(&mut pem).map_err(|_| invalid())?;
+    reqwest::Client::builder().tls_certs_merge(parse_scoped_ca(&pem)?)
+        .build().map_err(|_| invalid())
+}
