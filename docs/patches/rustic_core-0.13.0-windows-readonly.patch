+#[cfg(all(test, windows))]
+mod windows_readonly_tests {
+    use super::LocalSourceSaveOptions;
+    use crate::backend::{
+        local_destination::LocalDestination,
+        node::{Metadata, Node, NodeType},
+    };
+    use std::{ffi::OsStr, fs};
+
+    #[test]
+    fn windows_readonly_capture_and_restore_supported_file_mode() {
+        let root = tempfile::tempdir().unwrap();
+        let destination = LocalDestination::new(root.path().to_str().unwrap(), false, false).unwrap();
+        for readonly in [false, true] {
+            let source = root.path().join("source");
+            let restored = root.path().join("restored");
+            fs::write(&source, b"synthetic readonly source").unwrap();
+            fs::write(&restored, b"synthetic readonly source").unwrap();
+            let mut perms = fs::metadata(&source).unwrap().permissions();
+            perms.set_readonly(readonly);
+            fs::set_permissions(&source, perms).unwrap();
+            let (mode, _, _) = LocalSourceSaveOptions::nix_infos(&fs::metadata(&source).unwrap());
+            let node = Node::new_node(OsStr::new("restored"), NodeType::File,
+                Metadata { mode, ..Metadata::default() });
+            let mut perms = fs::metadata(&restored).unwrap().permissions();
+            perms.set_readonly(!readonly);
+            fs::set_permissions(&restored, perms).unwrap();
+            destination.set_permission("restored", &node).unwrap();
+            let observed = fs::metadata(&restored).unwrap().permissions().readonly();
+            let unchanged = fs::metadata(&source).unwrap().permissions().readonly() == readonly;
+            let equal_bytes = fs::read(&source).unwrap() == fs::read(&restored).unwrap();
+            for path in [&source, &restored] {
+                let mut perms = fs::metadata(path).unwrap().permissions();
+                perms.set_readonly(false);
+                fs::set_permissions(path, perms).unwrap();
+            }
+            assert_eq!(mode, Some(if readonly { 0o444 } else { 0o666 }));
+            assert_eq!(observed, readonly);
+            assert!(unchanged && equal_bytes);
+        }
+    }
+
+    #[test]
+    fn windows_readonly_directory_mode_matches_go() {
+        let root = tempfile::tempdir().unwrap();
+        for readonly in [false, true] {
+            let mut perms = fs::metadata(root.path()).unwrap().permissions();
+            perms.set_readonly(readonly);
+            fs::set_permissions(root.path(), perms).unwrap();
+            let (mode, _, _) = LocalSourceSaveOptions::nix_infos(&fs::metadata(root.path()).unwrap());
+            let mut perms = fs::metadata(root.path()).unwrap().permissions();
+            perms.set_readonly(false);
+            fs::set_permissions(root.path(), perms).unwrap();
+            assert_eq!(mode, Some((1 << 31) | if readonly { 0o555 } else { 0o777 }));
+        }
+    }
+}
