+#[cfg(test)]
+mod candidate_tree_auth {
+    use super::{Tree, TreeId, hash};
+
+    #[test]
+    fn accepts_exact_tree_bytes() {
+        let data = br#"{"nodes":[]}"#;
+        let id: TreeId = hash(data).into();
+        assert!(Tree::from_verified_data(data, id).is_ok());
+    }
+
+    #[test]
+    fn rejects_replayed_valid_tree_under_different_id() {
+        let expected = br#"{"nodes":[]}"#;
+        let replay = br#"{"nodes":null}"#;
+        let id: TreeId = hash(expected).into();
+        assert!(serde_json::from_slice::<Tree>(replay).is_ok());
+        assert!(Tree::from_verified_data(replay, id).is_err());
+    }
+}
