{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Josh: Save Room",
      "type": "process",
      "command": "josh-room",
      "args": [
        "snapshot",
        "create",
        "${input:roomName}",
        "--source",
        "${workspaceFolder}",
        "--backend",
        "r2"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Josh: Enter Room",
      "type": "shell",
      "command": "josh-room enter --backend r2",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ],
  "inputs": [
    {
      "id": "roomName",
      "type": "promptString",
      "description": "Room name",
      "default": "My Room"
    }
  ]
}
