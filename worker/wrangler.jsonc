{
  "name": "josh-room-auth",
  "main": "src/index.js",
  "compatibility_date": "2026-08-24",
  "observability": { "enabled": true },
  "vars": {
    "OAUTH_CLIENT_ID": "REPLACE_WITH_YOUR_OAUTH_CLIENT_ID",
    "OAUTH_REDIRECT_URI": "https://your-auth-worker.example/oauth/callback"
  },
  "kv_namespaces": [
    { "binding": "OAUTH_SESSIONS", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ]
}
